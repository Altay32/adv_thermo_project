        % Callback function: CalculateandPlotButton, V2inCCEditField
        function Calculate(app, event)
            % This script calculates the Salient P, T, V for a Petrol Cycle
% It also plots the P-V diagram 
P1 =   app.SuctionPressureinKPaSlider.Value;
T1 = app.InputTemperatureinKelvinSlider.Value;
q_in  = app.HeatAdditioninkJKgSlider.Value;
 r = app.CompressionRatioSlider.Value;
 V1 = app.CylinderVolumeinCCSlider.Value;

P1 = P1;   % Input Value in kPa
T1=  T1 ; % Input Value in Kelvin
r = r;  % Compression ratio
gamma = 1.4; % ratio of specific heats
q_in = q_in; % Input heating value in kJ/kg
V1 = V1; % Input volume in cubic meter
C_v = 0.718 ; % Input value in kJ/(kg K)
C_p = 1.005 ;  % Input value in kJ/(kg K)
R = 0.287 ;  % Standard value at 25 deg C, in kJ/(kg K)
s_0 = 8.24449 ;  % kJ/(kg K)
T_0 = 200 ; % The reference temperature for entropy
P_0 =  100 ; % The reference pressure for entropy
P2 = P1 * ((r)^gamma);
V2 = V1/r;
T2 = T1 * ((r)^(gamma -1 ));
T3 = T2 +  (q_in/C_v);
P3 = P2 *(T3/T2);
V3= V2;
T4 = T3 * ((1/r) ^ (gamma-1));
P4 = P3 * ((1/r)^ gamma);
V4 = V1;
q_out = C_v * (T4 -T1);
w_net = q_in - q_out;  
efficiency = w_net /q_in ;
s_1 = (C_p * log( T1/T_0)) - ( R * (log (P1/P_0)));
s_2  = (C_p * log( T2/T_0)) - ( R * (log (P2/P_0)));
s_3  = (C_p * log( T3/T_0)) - ( R * (log (P3/P_0)));
s_4  =  (C_p * log( T3/T_0)) - ( R * (log (P3/P_0)));
app.V2inCCEditField.Value = num2str(V2);
app.V3inCCEditField.Value = num2str(V3);
app.V4inCCEditField.Value = num2str(V4);
app.T2inKelvinEditField.Value = num2str(T2);
app.T3inKelvinEditField.Value  = num2str(T3);
app.T4inKelvinEditField.Value  = num2str(T4);
app.P2inkPaEditField.Value   =  num2str(P2);
app.P3inkPaEditField_2.Value = num2str(P3);
app.P4inkPaEditField.Value  = num2str(P4);
app.NetworkdonepercycleinkJkgEditField.Value = num2str(w_net);
%app.HeatoutinkJkgEditField.Value = num2str(w_net - q_in);
app.EfficiencyEditField.Value = num2str(efficiency);

V_temp1 = linspace(V1,V2,100) ;
V_temp2 = V2 * ones(1,10);
V_temp3 = linspace(V3,V4,100);
v_temp4 = V4 * ones (1,10);
P = P1 .*((V1./V_temp1).^gamma) ;
V = V_temp1;
c = app.n +1; 
 clr_arry = [ "blue"  , "green" , "red"  , "cyan" , "magenta", "black" ] ;
if c <= 6
  clr1= clr_arry(1, c);
  app.n = app.n + 1;
  cc= app.n ;
  app.cycl = 1;
else 
    c = 1 ;
    app.n = 1 ;
    clr1= clr_arry(1, c);
   close (1)
   close (2)
   app.cycl = 0;
%    clear app
end
if app.cycl >0 
figure (1)
ylabel("Pressure in kPa")
xlabel('Volume in cubic m')
title('Plot of Pressure vs Volume ')
plot(V,P,clr1)
hold on
P = P2:0.1*P2:P3 ;
[ a,b] = size (P) ;
V = V2 .* ones(1,b) ;
plot(V,P, clr1)
hold on
V_temp3= V3 : 0.01*(V4-V3) :V4;
V = V_temp3 ;
P=0 ;
P = P3 .*((V3./V_temp3).^gamma) ;
 plot(V,P,clr1) ;
 hold on
P =0;
V =0;
V = v_temp4;
P = linspace(P4, P1,10) ;
%plot(V,P,'DisplayName', "{" + (r) + "}", clr1)
plot(V,P)
ylabel("Pressure in kPa")
xlabel('Volume in cubic m')
title('Plot of Pressure vs Volume ')
%tex = text(50,6000,'$r ','FontSize',18,'Color',clr1)
hold on
% legend('r ', num2str(r),'AutoUpdate','on')
 %legend show

% if cc ==1
%     legend ('Parameters are', num2str(r,V1 ))
% else     
%     legappend(' ',num2str(r,V1))
% end
figure (2)
ylabel("Temperature in Kelvin ")
xlabel('Specific Entropy in kJ / (Kg K)')
title('Plot of Temperature vs Specific Entropy ')
T = 0;
S = 0;
T = linspace(T1,T2, 100);
P = linspace(P1,P2,100);
V = linspace (V1, V2,100);
S = s_1 * ones(1,100);
%S = (C_p .* log( T./T1))   - ( R * ( log (P./P1))) + s_1;
plot (S, T, clr1)
hold on
S = 0;
T = 0;
P = 0;
T = linspace(T2,T3,100);

P = linspace (P2,P3,100);
S = (C_p .* log( T./T2))   - ( R .* ( log (P./P2))) + s_1;
plot (S, T, clr1)
hold on
s_33 = S(1, end);
S = 0;
T = 0;
P = 0;
T = linspace(T3,T4,100);
S = s_33 * ones(1,100);
plot (S,T, clr1);
hold on
S = 0;
T =0;
P = 0;
T = linspace(T4,T1,100);
P = linspace(P4,P1,100);
S = (C_p .* log( T./T4))   - ( R .* ( log (P./P4))) + s_33 ;
plot(S,T, clr1)
ylabel("Temperature in Kelvin ")
xlabel('Specific Entropy in kJ / (Kg K)')
title('Plot of Temperature vs Specific Entropy ')
hold on 
end 
            
        end
    end

